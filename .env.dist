# DOM-ORM environment configuration template
# Copy to .env (or provide these via your runtime environment)

# Storage (Flysystem)
DOM_ORM_FLYSYSTEM_ADAPTER=League\Flysystem\Local\LocalFilesystemAdapter
DOM_ORM_FLYSYSTEM_LOCATION=./storage
DOM_ORM_FILENAME=data.xml
DOM_ORM_LOCK_FILE=

# Encryption (optional; enables #[Sensitive])
DOM_ORM_ENCRYPTION_KEY=

# Cache (optional)
DOM_ORM_CACHE_PATH=
DOM_ORM_CACHE_STRATEGY=manual

# Versioning
DOM_ORM_VERSIONING=false
DOM_ORM_VERSION_CONTROL=git
DOM_ORM_VERSION_CONTROL_PUSH=manual

# Export on persist (optional)
DOM_ORM_EXPORT_ON_PERSIST_FILE=
DOM_ORM_EXPORT_ON_PERSIST_XML=false
DOM_ORM_EXPORT_ON_PERSIST_YAML=false
DOM_ORM_EXPORT_ON_PERSIST_JSON=false
DOM_ORM_EXPORT_ON_PERSIST_PHP=false
