{
  "name": "vardumper/dom-orm",
  "description": "DOMDocument Object Relational Mapper (ORM)",
  "type": "library",
  "require": {
    "php": ">=8.3 <8.6",
    "ext-dom": "*",
    "ext-json": "*",
    "ext-libxml": "*",
    "ext-mbstring": "*",
    "ext-xml": "*",
    "ramsey/uuid": "^4.9.2",
    "ramsey/collection": "^2.1.1",
    "symfony/serializer": "^6.4.8 || ^7.4.8",
    "league/flysystem": "^3.33.0",
    "symfony/yaml": "^6.4.8 || ^7.4.8",
    "mnapoli/silly": "^1.9.1",
    "league/config": "^1.2"
  },
  "require-dev": {
    "pestphp/pest": "^4.0",
    "phpunit/phpunit": "^12.5.16",
    "phpstan/phpstan": "^1.12.33",
    "friendsofphp/php-cs-fixer": "^3.95.1",
    "symplify/easy-coding-standard": "^12.6.2",
    "brainmaestro/composer-git-hooks": "@dev"
  },
  "autoload": {
    "psr-4": {
      "DOM\\ORM\\": "src/"
    },
    "files": [
      "src/helpers.php"
    ]
  },
  "bin": [
    "dom-orm"
  ],
  "authors": [
    {
      "name": "Erik Pöhler",
      "email": "info@erikpoehler.com"
    }
  ],
  "extra": {
    "hooks": {
      "pre-commit": [
        ".githooks/pre-commit.sh"
      ],
      "commit-msg": [
        ".githooks/commit-msg.sh"
      ]
    }
  },
  "scripts": {
    "test": "pest",
    "check-cs": "ecs check --ansi",
    "fix-cs": "ecs check --ansi --fix",
    "phpstan": "phpstan --memory-limit=1G --configuration=./phpstan.neon",
    "post-install-cmd": [
      "./vendor/bin/cghooks add --ignore-lock"
    ],
    "post-update-cmd": [
      "./vendor/bin/cghooks update"
    ]
  },
  "minimum-stability": "stable",
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
