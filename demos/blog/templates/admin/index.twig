{% extends 'layout.twig' %}

{% block content %}
  <hgroup>
    <h2>Admin Panel</h2>
    <p>Manage articles and comments. <a href="{{ basePath }}/">← Back to blog</a></p>
  </hgroup>

  <article>
    <header><h3>New Article</h3></header>
    {% include 'article-add.twig' %}
  </article>

  <h3>All Articles</h3>
  {% for article in articles %}
    {% include 'admin/article.twig' with { article: article } %}
  {% else %}
    <p><em>No articles yet.</em></p>
  {% endfor %}
{% endblock %}
