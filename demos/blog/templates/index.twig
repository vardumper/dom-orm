{% extends 'layout.twig' %}

{% block notice %}
  <aside id="admin-hint" class="demo-hint" role="note" aria-label="Demo hint">
    <button type="button" id="admin-hint-close" class="demo-hint-close" aria-label="Dismiss this hint">
      <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
    <p class="demo-hint-body">
      <strong>This is a live demo.</strong> Open
      <button type="button" id="admin-hint-menu" class="demo-hint-link">the menu</button>
      &nbsp;(&#9776;) and choose <a href="{{ basePath }}/admin">Admin</a> to
      add or delete articles.
      <span class="badge demo-hint-badge" id="admin-hint-reset-badge">
          Resets in <span id="admin-hint-countdown">--:--</span>
      </span>
    </p>
  </aside>
{% endblock %}

{% block content %}
  {% for article in articles %}
    {% include 'article.twig' with { article: article } %}
  {% else %}
    <p><em>No articles yet. Visit the <a href="{{ basePath }}/admin">admin panel</a> to add one.</em></p>
  {% endfor %}
{% endblock %}

{% block body_extra %}
<script>
  (function () {
    const hint = document.getElementById('admin-hint');
    if (!hint) return;

    const STORAGE_KEY = 'dom-orm-blog-hint-dismissed';

    // Respect a previous dismissal.
    if (localStorage.getItem(STORAGE_KEY)) {
      hint.classList.add('is-hidden');
    }

    document.getElementById('admin-hint-close').addEventListener('click', function () {
      hint.classList.add('is-hidden');
      localStorage.setItem(STORAGE_KEY, '1');
    });

    // "the menu" button opens the existing sidebar drawer.
    const menuButton = document.getElementById('admin-hint-menu');
    if (menuButton) {
      menuButton.addEventListener('click', function (event) {
        event.preventDefault();
        openSidebar();
      });
    }

    // Live countdown until the demo state is restored to the pristine seed.
    const resetAt = {{ resetAt }}; // unix seconds; 0 when unknown
    const countdown = document.getElementById('admin-hint-countdown');
    const resetBadge = document.getElementById('admin-hint-reset-badge');
    if (resetAt && countdown) {
      function formatCountdown(ms) {
        const total = Math.max(0, Math.round(ms / 1000));
        const m = Math.floor(total / 60);
        const s = total % 60;
        return String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0');
      }
      function tick() {
        const remaining = resetAt * 1000 - Date.now();
        if (remaining <= 0) {
          resetBadge.textContent = 'Resetting now';
          return;
        }
        countdown.textContent = formatCountdown(remaining);
        setTimeout(tick, 1000);
      }
      tick();
    }
  })();
</script>
{% endblock %}
