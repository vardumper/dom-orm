error_reporting(E_ALL & ~E_DEPRECATED & ~E_USER_DEPRECATED);

set_error_handler(static function ($severity, $message, $file, $line) {
    if ($severity & error_reporting()) {
        throw new ErrorException($message, 0, $severity, $file, $line);
    }
});

$possibleFiles = [__DIR__ . '/../../autoload.php', __DIR__ . '/../autoload.php', __DIR__ . '/vendor/autoload.php'];
$file = current(array_filter($possibleFiles, 'file_exists'));

if ($file === null) {
    throw new RuntimeException('Unable to locate autoload.php file.');
}

require_once $file;

use DOM\ORM\Command\Backup;
use DOM\ORM\Command\Cleanup;
use DOM\ORM\Command\Diagnose;
use DOM\ORM\Command\Export;
use DOM\ORM\Command\Import;
use DOM\ORM\Command\Init;
use DOM\ORM\Command\Migrate;
use DOM\ORM\Command\Perf;
use DOM\ORM\Command\Validate;
use DOM\ORM\Storage\QueryCache;
use Silly\Application;
use Symfony\Component\Console\Output\ConsoleOutputInterface;

$app = new Application('DOM-ORM CLI Tool', '0.1.0');

$app->command('list', function (ConsoleOutputInterface $output) {
    $output->writeln(sprintf('DOM-ORM <fg=green>%s</>', '1.0.0'));
    $output->writeln('Available commands:');
    $output->writeln('<fg=green>backup</>           Backup the database.');
    $output->writeln('<fg=green>build-cache</>      Build the read-only PHP query cache from XML.');
    $output->writeln('<fg=green>cleanup</>          Remove orphaned fragments from XML.');
    $output->writeln('<fg=green>diagnose</>         Diagnose the database.');
    $output->writeln('<fg=green>export</>           Export the database to JSON, YAML, or PHP array.');
    $output->writeln('<fg=green>flush-cache</>      Delete the query cache file.');
    $output->writeln('<fg=green>import</>           Import into the database.');
    $output->writeln('<fg=green>init</>             Initialize the database');
    $output->writeln('<fg=green>list</>             List commands');
    $output->writeln('<fg=green>migrate</>          Apply fragment rename/removal maps to XML.');
    $output->writeln('<fg=green>perf</>             Run a performance benchmark (seed + query).');
    $output->writeln('<fg=green>schema-validate</>  Validate the database schema.');
});

$app->command('init', function (ConsoleOutputInterface $output) {
    $output->writeln('Initializing database...');
    Init::run();
    $output->writeln('Done.');
});

$app->command('backup', function (ConsoleOutputInterface $output) {
    $output->writeln('Creating a database backup...');
    Backup::run();
    $output->writeln('Done.');
});

$app->command('migrate [--dry-run] [--force]', function (bool $dryRun, bool $force, ConsoleOutputInterface $output) {
    if ($dryRun) {
        $output->writeln('<fg=yellow>Dry-run mode — no changes will be written.</>');
    } else {
        $output->writeln('Applying fragment migrations...');
    }
    $stats = Migrate::run(dryRun: $dryRun, force: $force);
    $output->writeln(\sprintf(
        '%s: %d fragment(s) renamed, %d fragment(s) removed across %d item(s).',
        $dryRun ? 'Would apply' : 'Applied',
        $stats['renamed'],
        $stats['removed'],
        $stats['items_affected'],
    ));
    if (!$dryRun) {
        $output->writeln('Done.');
    }
});

$app->command('cleanup [--dry-run]', function (bool $dryRun, ConsoleOutputInterface $output) {
    if ($dryRun) {
        $output->writeln('<fg=yellow>Dry-run mode — no changes will be written.</>');
    } else {
        $output->writeln('Removing orphaned fragments...');
    }
    $stats = Cleanup::run(dryRun: $dryRun);
    $output->writeln(\sprintf(
        '%s: %d orphaned fragment(s) removed across %d item(s).',
        $dryRun ? 'Would remove' : 'Removed',
        $stats['removed'],
        $stats['items_affected'],
    ));
    if (!empty($stats['unknown_types'])) {
        $output->writeln(\sprintf(
            '<fg=yellow>Warning: %d entity type(s) in XML have no matching class and were skipped: %s</>',
            \count($stats['unknown_types']),
            \implode(', ', $stats['unknown_types']),
        ));
    }
    if (!$dryRun) {
        $output->writeln('Done.');
    }
});

$app->command('schema-validate', function (ConsoleOutputInterface $output) {
    $output->writeln('Validating database against schema...');
    Validate::run();
    $output->writeln('Done.');
});

$app->command('import [file]', function ($file, ConsoleOutputInterface $output) {
    $output->writeln('Importing into database...');
    Import::run();
    $output->writeln('Done.');
});

$app->command('export [file] [--xml] [--yaml] [--json] [--php]', function ($file, $xml, $yaml, $json, $php, ConsoleOutputInterface $output) {
    $output->writeln('Exporting database...');
    Export::run($file, $xml ?? false, $yaml ?? false, $json ?? false, $php ?? false);
    $output->writeln('Done.');
});

$app->command('build-cache', function (ConsoleOutputInterface $output) {
    if (!QueryCache::isEnabled()) {
        $output->writeln('<fg=yellow>cache_path is not set in dom-orm.php — nothing to do.</>\nAdd <fg=green>\'cache_path\' => \'/path/to/cache.php\'</> to your dom-orm.php to enable the query cache.');

        return;
    }
    $output->writeln('Building query cache...');
    QueryCache::build();
    $output->writeln(\sprintf('Cache written to <fg=green>%s</>.', QueryCache::getCachePath()));
    $output->writeln('Done.');
});

$app->command('flush-cache', function (ConsoleOutputInterface $output) {
    if (!QueryCache::exists()) {
        $output->writeln('No cache file found — nothing to flush.');

        return;
    }
    $path = QueryCache::getCachePath();
    QueryCache::flush();
    $output->writeln(\sprintf('Flushed cache at <fg=green>%s</>.', $path));
    $output->writeln('Done.');
});

$app->command('diagnose', function (ConsoleOutputInterface $output) {
    $output->writeln('Diagnose database...');
    Diagnose::run();
});

$app->command(
    'perf [--count=] [--sample=] [--keep]',
    function (?int $count, ?int $sample, bool $keep, ConsoleOutputInterface $output): void {
        $count  = $count  ?? 100_000;
        $sample = $sample ?? 50;

        $sep = \str_repeat('─', 54);

        $output->writeln("\n<fg=cyan;options=bold>DOM-ORM Performance Report</>\n{$sep}");
        $output->writeln(\sprintf(
            '<fg=yellow>Entities : %s  |  One-by-one sample : %s</>',
            \number_format($count),
            \number_format($sample),
        ));
        $output->writeln('');
        $output->writeln("<options=bold>Running… (this may take a minute)</>\n");

        $s  = Perf::run($count, $sample, $keep);
        $ms = static fn (float $v): string => \number_format($v, 2) . ' ms';

        $output->writeln('<options=bold>[WRITE — one-by-one]</>');
        $output->writeln(\sprintf(
            '  Sample (%d entities)  : <fg=green>%s</> total  (<fg=green>%s</> each)',
            $sample, $ms($s['one_by_one_sample_ms']),
            \number_format($s['one_by_one_per_entity_ms'], 4) . ' ms',
        ));
        $output->writeln(\sprintf(
            '  Extrapolated (%s) : ~<fg=yellow>%s</> total',
            \number_format($count),
            $ms($s['one_by_one_estimated_total_ms']),
        ));
        $output->writeln('  <fg=gray>Note: each persist() re-serialises the full growing XML document.</>');

        $output->writeln('');
        $output->writeln('<options=bold>[WRITE — batch (persistBatch → one save)]</>');
        $output->writeln(\sprintf(
            '  %s entities     : <fg=green>%s</> total  (<fg=green>%s</> each)',
            \number_format($count), $ms($s['batch_total_ms']),
            \number_format($s['batch_per_entity_ms'], 4) . ' ms',
        ));
        $output->writeln(\sprintf('  Resulting XML size  : <fg=green>%s KB</>', \number_format($s['batch_xml_kb'])));
        $output->writeln(\sprintf(
            '  Speedup vs one-by-one : ~<fg=cyan>%.0f×</>',
            $s['one_by_one_estimated_total_ms'] / \max($s['batch_total_ms'], 0.001),
        ));

        $output->writeln('');
        $output->writeln('<options=bold>[READ — XPath (no cache)]</>');
        $output->writeln(\sprintf('  findAll()           : <fg=green>%s</>', $ms($s['find_all_ms'])));
        $output->writeln(\sprintf('  find() by id        : <fg=green>%s</>', $ms($s['find_one_ms'])));
        $output->writeln(\sprintf('  findOneBy() by name : <fg=green>%s</>', $ms($s['find_one_by_ms'])));

        $output->writeln('');
        $output->writeln('<options=bold>[READ — PHP query cache]</>');
        $output->writeln(\sprintf('  Cache build         : <fg=green>%s</>', $ms($s['cache_build_ms'])));
        $output->writeln(\sprintf(
            '  findAll()           : <fg=green>%s</>  (<fg=cyan>%.1f×</> speedup)',
            $ms($s['cache_find_all_ms']),
            $s['find_all_ms'] / \max($s['cache_find_all_ms'], 0.001),
        ));
        $output->writeln(\sprintf(
            '  find() by id        : <fg=green>%s</>  (<fg=cyan>%.1f×</> speedup)',
            $ms($s['cache_find_one_ms']),
            $s['find_one_ms'] / \max($s['cache_find_one_ms'], 0.001),
        ));
        $output->writeln(\sprintf(
            '  findOneBy() by name : <fg=green>%s</>  (<fg=cyan>%.1f×</> speedup)',
            $ms($s['cache_find_one_by_ms']),
            $s['find_one_by_ms'] / \max($s['cache_find_one_by_ms'], 0.001),
        ));
        $output->writeln('');
    },
);

// $app->setDefaultCommand('list');
$app->run();

__HALT_COMPILER();
